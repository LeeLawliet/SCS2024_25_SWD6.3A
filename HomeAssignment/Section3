# Installing and Importing Packages
install.packages("caret")
install.packages("cluster")
install.packages("factoextra")
install.packages("ggplot2")
install.packages("readxl")
library(caret)
library(cluster)
library(readxl)
library(factoextra)
library(ggplot2)

# ---------------- TASK 3 -------------------
# Importing data from Excel, remove 'Class' (y) attribute
data <- read_excel("C:/Users/deadr/Documents/MCAST/SCS2024_25_SWD6.3A/HomeAssignment/Dataset/DryBeanDataset/Dry_Bean_Dataset.xlsx")
dataNoClass = data
dataNoClass$Class <- NULL

# PCA
pca_result <- prcomp(dataNoClass, center = TRUE, scale. = TRUE)
summary(pca_result)

# Eigenvalues
eigenvalues <- pca_result$sdev^2
sorted_eigenvalues <- sort(eigenvalues, decreasing = TRUE)
sorted_eigenvalues

# Select top 3 principal components
pca_data <- data.frame(pca_result$x[, 1:2])

pca_data$Class <- data$Class

# Perform K-Means Clustering
set.seed(123)
kmeans_result <- kmeans(pca_data, centers = 3, nstart = 25)
kmeans_result$cluster

# Save cluster in pca_data and create cluster class table
pca_data$cluster <- kmeans_result$cluster
cluster_class_table <- table(pca_data$cluster, pca_data$Class)
print(cluster_class_table)

pca_data$relabelled_cluster <- factor(kmeans_result$cluster, 
                                      levels = c(1, 2, 3), 
                                      labels = c("DERMASON", "CALI", "BARBUNYA"))

conf_matrix <- confusionMatrix(pca_data$relabelled_cluster, pca_data$Class)
print(conf_matrix)

# ---------------- TASK 4 -------------------
silhouette_result <- silhouette(kmeans_result$cluster, dist(pca_data[, 1:2]))
fviz_silhouette(silhouette_result)
summary(silhouette_result)

